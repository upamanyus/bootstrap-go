; The rule table for the raft code: what the table-driven checker (tcheck/)
; may assume about it.  Every rule and fact here is proved, by linking to an
; existing lemma, in link_table_raft.v (rules for callees are linked to the
; postulates of the proof that uses them).  gocheck/tcheck turns this file
; into table_raft.v; see gocheck/tcheck/README.md.
(table raft
  (require "New.proof.go_etcd_io.raft.election_proof.inv_raft_phys")
  (require "New.proof.go_etcd_io.raft.election_proof.inv_logger")
  (code "new/code/go_etcd_io/raft/v3.v" raft)
  (assumptions `raft.Assumptions`)

  ;; Sorts.
  (sort cfgset `gset w64`)
  (sort loc `loc`)
  (sort w64 `w64`)
  (sort nstate `nstate.t`)
  (sort func `func.t`)
  (sort role `role.t`)
  (sort lok `interface.t_ok`)
  (sort pvs `gmap w64 (tracker.Progress.t * tracker.Inflights.t)`)
  (sort slice `slice.t`)

  ;; Values.
  (sym val_loc (loc) val `λ l : loc, #l`)
  (sym val_w64 (w64) val `λ w : w64, #w`)
  (sym val_func (func) val `λ f : func.t, #f`)
  (sym val_slice (slice) val `λ s : slice.t, #s`)
  (sym val_lok (lok) val `λ l : interface.t_ok, #(interface.ok l)`)
  (sym conv_u64_iface (w64) val `λ w : w64, #(interface.mk_ok go.uint64 #w)`)

  ;; Fields of the raft struct.
  (sym fld_step (loc) loc `λ r : loc, r.[raft.raft.t, "step"]`)
  (sym fld_tick (loc) loc `λ r : loc, r.[raft.raft.t, "tick"]`)
  (sym fld_lead (loc) loc `λ r : loc, r.[raft.raft.t, "lead"]`)
  (sym fld_state (loc) loc `λ r : loc, r.[raft.raft.t, "state"]`)
  (sym fld_id (loc) loc `λ r : loc, r.[raft.raft.t, "id"]`)
  (sym fld_Term (loc) loc `λ r : loc, r.[raft.raft.t, "Term"]`)
  (sym fld_logger (loc) loc `λ r : loc, r.[raft.raft.t, "logger"]`)

  ;; Functions and methods.
  (sym fn_stepFollower () func `functions raft.stepFollower []`)
  (sym fn_traceBecomeFollower () func `functions raft.traceBecomeFollower []`)
  (sym meth_reset (loc) func `λ r : loc, methods (go.PointerType raft.raft) "reset"%go #r`)
  (sym meth_tickElection (loc) func `λ r : loc, methods (go.PointerType raft.raft) "tickElection"%go #r`)
  (sym meth_Infof (lok) func `λ l : interface.t_ok, methods l.(interface.ty) "Infof"%go l.(interface.v)`)

  ;; The physical state [nstate.t] (election_proof/defs.v).
  (sym nterm (nstate) w64 `λ s : nstate.t, s.(nstate.term)`)
  (sym set_stepfn (nstate func) nstate `λ (s : nstate.t) (f : func.t), s <| nstate.stepfn := f |>`)
  (sym set_prvals (nstate pvs) nstate `λ s p, s <| nstate.prvals := p |>`)
  (sym set_lead (nstate w64) nstate `λ (s : nstate.t) (v : w64), s <| nstate.lead := v |>`)
  (sym set_role (nstate role) nstate `λ (s : nstate.t) (ro : role.t), s <| nstate.role := ro |>`)
  (sym reset_to (nstate w64) nstate `reset_to`)
  (sym become_follower (nstate w64 w64) nstate `become_follower`)
  (sym role_Follower () role `role.Follower`)

  ;; Code constants: the values (and the one Go type) in the code, exactly as
  ;; gocheck/tcheck prints them from the Goose output.
  (const k_alloc_ptr_raft `GoInstruction (GoAlloc (go.PointerType raft.raft))`)
  (const k_alloc_u64 `GoInstruction (GoAlloc go.uint64)`)
  (const k_load_ptr_raft `GoInstruction (GoLoad (go.PointerType raft.raft))`)
  (const k_load_u64 `GoInstruction (GoLoad go.uint64)`)
  (const k_load_Logger `GoInstruction (GoLoad raft.Logger)`)
  (const k_store_stepFunc `GoInstruction (GoStore raft.stepFunc)`)
  (const k_store_func0 `GoInstruction (GoStore (go.FunctionType (go.Signature [] false [])))`)
  (const k_store_u64 `GoInstruction (GoStore go.uint64)`)
  (const k_store_StateType `GoInstruction (GoStore raft.StateType)`)
  (const k_sfr_step `GoInstruction (StructFieldRef raft.raft "step"%go)`)
  (const k_sfr_tick `GoInstruction (StructFieldRef raft.raft "tick"%go)`)
  (const k_sfr_lead `GoInstruction (StructFieldRef raft.raft "lead"%go)`)
  (const k_sfr_state `GoInstruction (StructFieldRef raft.raft "state"%go)`)
  (const k_sfr_id `GoInstruction (StructFieldRef raft.raft "id"%go)`)
  (const k_sfr_Term `GoInstruction (StructFieldRef raft.raft "Term"%go)`)
  (const k_sfr_logger `GoInstruction (StructFieldRef raft.raft "logger"%go)`)
  (const k_fr_stepFollower `GoInstruction (FuncResolve raft.stepFollower [])`)
  (const k_fr_traceBecomeFollower `GoInstruction (FuncResolve raft.traceBecomeFollower [])`)
  (const k_mr_reset `GoInstruction (MethodResolve (go.PointerType raft.raft) "reset"%go)`)
  (const k_mr_tickElection `GoInstruction (MethodResolve (go.PointerType raft.raft) "tickElection"%go)`)
  (const k_mr_Infof `GoInstruction (MethodResolve raft.Logger "Infof"%go)`)
  (const k_conv_u64_iface `GoInstruction (Convert go.uint64 (go.InterfaceType []))`)
  (const k_complit_iface_slice `GoInstruction (CompositeLiteral (go.SliceType (go.InterfaceType [])))`)
  (tconst k_ty_iface `go.InterfaceType []`)
  (const k_StateFollower `raft.StateFollower`)
  (const k_fmt_becomeFollower `#"%x became follower at term %d"%go`)

  ;; Predicates.
  (pred pkg_init persistent () `is_pkg_init raft`)
  (pred phys (cfgset loc w64 nstate) `own_raft_phys`)
  (pred pt_loc (loc loc) `λ l v : loc, (l ↦ v)%I`)
  (pred pt_w64 (loc w64) `λ (l : loc) (v : w64), (l ↦ v)%I`)
  (pred logger persistent (lok) `is_Logger`)

  ;; Locals.
  (rule alloc_loc (vars (v loc)) (lhs (app k_alloc_ptr_raft (val_loc v)))
    (ex (l loc)) (ret (val_loc l)) (post (pt_loc l v)))
  (rule alloc_w64 (vars (v w64)) (lhs (app k_alloc_u64 (val_w64 v)))
    (ex (l loc)) (ret (val_loc l)) (post (pt_w64 l v)))
  (rule load_loc (vars (l loc) (v loc)) (lhs (app k_load_ptr_raft (val_loc l)))
    (pre (pt_loc l v)) (ret (val_loc v)) (post (pt_loc l v)))
  (rule load_w64 (vars (l loc) (v w64)) (lhs (app k_load_u64 (val_loc l)))
    (pre (pt_w64 l v)) (ret (val_w64 v)) (post (pt_w64 l v)))

  ;; Pure steps: field references, function and method values, conversions.
  (rule sfr_step (vars (r loc)) (lhs (app k_sfr_step (val_loc r))) (ret (val_loc (fld_step r))))
  (rule sfr_tick (vars (r loc)) (lhs (app k_sfr_tick (val_loc r))) (ret (val_loc (fld_tick r))))
  (rule sfr_lead (vars (r loc)) (lhs (app k_sfr_lead (val_loc r))) (ret (val_loc (fld_lead r))))
  (rule sfr_state (vars (r loc)) (lhs (app k_sfr_state (val_loc r))) (ret (val_loc (fld_state r))))
  (rule sfr_id (vars (r loc)) (lhs (app k_sfr_id (val_loc r))) (ret (val_loc (fld_id r))))
  (rule sfr_Term (vars (r loc)) (lhs (app k_sfr_Term (val_loc r))) (ret (val_loc (fld_Term r))))
  (rule sfr_logger (vars (r loc)) (lhs (app k_sfr_logger (val_loc r))) (ret (val_loc (fld_logger r))))
  (rule fr_stepFollower (vars) (lhs (app k_fr_stepFollower unit)) (ret (val_func fn_stepFollower)))
  (rule fr_traceBecomeFollower (vars) (lhs (app k_fr_traceBecomeFollower unit))
    (ret (val_func fn_traceBecomeFollower)))
  (rule mr_reset (vars (r loc)) (lhs (app k_mr_reset (val_loc r))) (ret (val_func (meth_reset r))))
  (rule mr_tickElection (vars (r loc)) (lhs (app k_mr_tickElection (val_loc r)))
    (ret (val_func (meth_tickElection r))))
  (rule mr_Infof (vars (l lok)) (lhs (app k_mr_Infof (val_lok l))) (ret (val_func (meth_Infof l))))
  (rule conv_u64_iface (vars (w w64)) (lhs (app k_conv_u64_iface (val_w64 w))) (ret (conv_u64_iface w)))

  ;; Fields of the raft struct (the wp_raft_load_* / wp_raft_store_* lemmas
  ;; of election_proof/inv_raft_phys.v).
  (rule store_step (vars (cfg cfgset) (r loc) (id w64) (s nstate) (f func))
    (lhs (app k_store_stepFunc (pair (val_loc (fld_step r)) (val_func f))))
    (pre (phys cfg r id s)) (ret unit) (post (phys cfg r id (set_stepfn s f))))
  (rule store_tick (vars (cfg cfgset) (r loc) (id w64) (s nstate) (f func))
    (lhs (app k_store_func0 (pair (val_loc (fld_tick r)) (val_func f))))
    (pre (phys cfg r id s)) (ret unit) (post (phys cfg r id s)))
  (rule store_lead (vars (cfg cfgset) (r loc) (id w64) (s nstate) (v w64))
    (lhs (app k_store_u64 (pair (val_loc (fld_lead r)) (val_w64 v))))
    (pre (phys cfg r id s)) (ret unit) (post (phys cfg r id (set_lead s v))))
  (rule store_state_Follower (vars (cfg cfgset) (r loc) (id w64) (s nstate))
    (lhs (app k_store_StateType (pair (val_loc (fld_state r)) k_StateFollower)))
    (pre (phys cfg r id s)) (ret unit) (post (phys cfg r id (set_role s role_Follower))))
  (rule load_id (vars (cfg cfgset) (r loc) (id w64) (s nstate))
    (lhs (app k_load_u64 (val_loc (fld_id r))))
    (pre (phys cfg r id s)) (ret (val_w64 id)) (post (phys cfg r id s)))
  (rule load_Term (vars (cfg cfgset) (r loc) (id w64) (s nstate))
    (lhs (app k_load_u64 (val_loc (fld_Term r))))
    (pre (phys cfg r id s)) (ret (val_w64 (nterm s))) (post (phys cfg r id s)))
  (rule load_logger (vars (cfg cfgset) (r loc) (id w64) (s nstate))
    (lhs (app k_load_Logger (val_loc (fld_logger r))))
    (pre (phys cfg r id s)) (ex (l lok)) (ret (val_lok l)) (post (phys cfg r id s) (logger l)))

  ;; Logging: the argument slice, and the Logger spec (inv_logger.v).
  (rule slice_lit_u64_u64 (vars (a w64) (b w64))
    (lhs (app k_complit_iface_slice (lit k_ty_iface (conv_u64_iface a) (conv_u64_iface b))))
    (ex (sl slice)) (ret (val_slice sl)))
  (rule logf_Infof_becomeFollower (vars (l lok) (sl slice))
    (lhs (app (app (val_func (meth_Infof l)) k_fmt_becomeFollower) (val_slice sl)))
    (pre (logger l)) (ret unit))

  ;; Callees (linked to the postulates of the proof that uses them).
  (rule reset (vars (cfg cfgset) (r loc) (id w64) (s nstate) (term w64))
    (lhs (app (val_func (meth_reset r)) (val_w64 term)))
    (pre (pkg_init) (phys cfg r id s)) (ex (pvs pvs)) (ret unit)
    (post (phys cfg r id (set_prvals (reset_to s term) pvs))))
  (rule traceBecomeFollower (vars (r loc))
    (lhs (app (val_func fn_traceBecomeFollower) (val_loc r)))
    (pre (pkg_init)) (ret unit))

  ;; What becomeFollower's stores amount to (become_follower, defs.v).
  (fact become_follower
    (vars (s nstate) (term w64) (pvs pvs) (lead w64))
    (lhs (set_role (set_lead (set_prvals (reset_to (set_stepfn s fn_stepFollower) term) pvs) lead)
           role_Follower))
    (rhs (set_prvals (become_follower s term lead) pvs)))

  ;; Specifications (election_proof/spec_*.v).
  (func becomeFollower `raft__becomeFollowerⁱᵐᵖˡ`
    (vars (cfg cfgset) (r loc) (id w64) (s nstate) (term w64) (lead w64))
    (args (val_loc r) (val_w64 term) (val_w64 lead))
    (pre (pkg_init) (phys cfg r id s))
    (ex (pvs pvs)) (ret unit)
    (post (phys cfg r id (set_prvals (become_follower s term lead) pvs)))))
