  Loc' : Loc
  Val' : Loc

instance Cell.zero_val [FfiSyntax] : ZeroVal Cell :=
  ⟨Cell.mk zeroValDef zeroValDef⟩

@[reducible] def Cell.fieldsUnsealed [FfiSyntax] [GoGlobalContext] : List go.field_decl :=
  [(go.field_decl.FieldDecl go!"Loc" (go.GoType.PointerType Term.ty)),
(go.field_decl.FieldDecl go!"Val" (go.GoType.PointerType Term.ty))]

@[irreducible] def Cell.fields [FfiSyntax] [GoGlobalContext] : List go.field_decl :=
  Cell.fieldsUnsealed

instance equals_unfold_Cell [FfiSyntax] [GoGlobalContext] :
    EqualsUnfold Cell.fields Cell.fieldsUnsealed :=
  ⟨by unfold Cell.fields; rfl⟩

@[reducible] def Cell.underlying [FfiSyntax] [GoGlobalContext] : go.GoType :=
  (go.GoType.StructType Cell.fields)

class Cell.TypeAssumptions [FfiSyntax] [GoGlobalContext] [GoLocalContext] [GoSemanticsFunctions] : Prop where
  type_repr : go.TypeReprUnderlying Cell.underlying Cell
  underlying : go.UnderlyingDirectedEq Cell.ty Cell.underlying
  get_Loc : ∀ (x : Cell), go.IsGoStepPureDetTagged under (StructFieldGet Cell.underlying go!"Loc") #x (Val #(x.Loc'))
  set_Loc : ∀ (x : Cell) (y : Loc), go.IsGoStepPureDetTagged under (StructFieldSet Cell.underlying go!"Loc") (PairV #x #y) (Val #(({ x with Loc' := y } : Cell)))
  get_Val : ∀ (x : Cell), go.IsGoStepPureDetTagged under (StructFieldGet Cell.underlying go!"Val") #x (Val #(x.Val'))
  set_Val : ∀ (x : Cell) (y : Loc), go.IsGoStepPureDetTagged under (StructFieldSet Cell.underlying go!"Val") (PairV #x #y) (Val #(({ x with Val' := y } : Cell)))

attribute [instance] Cell.TypeAssumptions.type_repr
  Cell.TypeAssumptions.underlying
  Cell.TypeAssumptions.get_Loc
  Cell.TypeAssumptions.set_Loc
  Cell.TypeAssumptions.get_Val
  Cell.TypeAssumptions.set_Val

